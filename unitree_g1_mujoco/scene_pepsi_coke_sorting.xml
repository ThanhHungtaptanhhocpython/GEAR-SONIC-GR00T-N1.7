<mujoco model="unitree_g1_can_sorting">
  <include file="unitree_g1/g1_with_hands.xml"/>

  <statistic center="0.3 0 0.8" extent="1.6"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25" specular="0.8 0.8 0.8"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="145" elevation="-25"/>
  </visual>

  <asset>
    <!-- Môi trường & Sàn -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.22 0.25 0.28" rgb2="0.15 0.17 0.20" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Vật liệu Bàn & Khay & Lon nước -->
    <material name="table_mat" rgba="0.85 0.82 0.78 1" specular="0.3" shininess="0.2"/>
    <material name="table_legs" rgba="0.2 0.2 0.2 1" specular="0.5"/>
    
    <!-- Lon Coca-Cola (Đỏ rực, phản xạ kim loại nhẹ) -->
    <material name="coke_mat" rgba="0.90 0.08 0.08 1" specular="0.7" shininess="0.6" reflectance="0.3"/>
    <material name="can_lid_mat" rgba="0.85 0.85 0.85 1" specular="0.9" shininess="0.8" reflectance="0.5"/>
    
    <!-- Lon Pepsi (Xanh dương, phản xạ kim loại nhẹ) -->
    <material name="pepsi_mat" rgba="0.05 0.25 0.85 1" specular="0.7" shininess="0.6" reflectance="0.3"/>

    <!-- Khay phân loại -->
    <material name="coke_tray_mat" rgba="0.95 0.2 0.2 0.6" specular="0.4"/>
    <material name="pepsi_tray_mat" rgba="0.2 0.4 0.95 0.6" specular="0.4"/>
  </asset>

  <worldbody>
    <!-- Sàn nhà -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Bàn làm việc (Đặt trước mặt robot G1 tại X = 0.48m) -->
    <body name="work_table" pos="0.48 0 0">
      <!-- Mặt bàn (Kích thước: dài 0.6m, rộng 0.9m, dày 0.04m, độ cao mặt bàn = 0.68m) -->
      <geom name="table_top" type="box" pos="0 0 0.66" size="0.30 0.45 0.02" material="table_mat"/>
      <!-- Chân bàn -->
      <geom name="leg1" type="cylinder" pos=" 0.25  0.40 0.32" size="0.02 0.32" material="table_legs"/>
      <geom name="leg2" type="cylinder" pos="-0.25  0.40 0.32" size="0.02 0.32" material="table_legs"/>
      <geom name="leg3" type="cylinder" pos=" 0.25 -0.40 0.32" size="0.02 0.32" material="table_legs"/>
      <geom name="leg4" type="cylinder" pos="-0.25 -0.40 0.32" size="0.02 0.32" material="table_legs"/>
    </body>

    <!-- ==================== VẬT THỂ PHÂN LOẠI ==================== -->
    
    <!-- 1. Lon Coca-Cola (Bên tay phải robot: Y = -0.12) -->
    <body name="coke_can" pos="0.42 -0.12 0.745">
      <freejoint name="coke_joint"/>
      <!-- Thân lon Coke tiêu chuẩn: đường kính 66mm (R=0.033), cao 122mm (H=0.061) -->
      <geom name="coke_body" type="cylinder" size="0.033 0.058" material="coke_mat" mass="0.2" friction="1.2 0.01 0.001"/>
      <geom name="coke_top" type="cylinder" pos="0 0 0.059" size="0.031 0.002" material="can_lid_mat"/>
    </body>

    <!-- 2. Lon Pepsi (Bên tay trái robot: Y = +0.12) -->
    <body name="pepsi_can" pos="0.42 0.12 0.745">
      <freejoint name="pepsi_joint"/>
      <!-- Thân lon Pepsi -->
      <geom name="pepsi_body" type="cylinder" size="0.033 0.058" material="pepsi_mat" mass="0.2" friction="1.2 0.01 0.001"/>
      <geom name="pepsi_top" type="cylinder" pos="0 0 0.059" size="0.031 0.002" material="can_lid_mat"/>
    </body>

    <!-- ==================== KHAY PHÂN LOẠI (SORTING TRAYS) ==================== -->

    <!-- Khay chứa Coca-Cola (Bên phải bàn: Y = -0.32) -->
    <body name="coke_tray" pos="0.45 -0.32 0.685">
      <geom name="coke_tray_base" type="box" size="0.10 0.10 0.005" material="coke_tray_mat"/>
      <!-- Thành khay -->
      <geom type="box" pos=" 0.095 0 0.015" size="0.005 0.10 0.015" rgba="0.9 0.2 0.2 0.8"/>
      <geom type="box" pos="-0.095 0 0.015" size="0.005 0.10 0.015" rgba="0.9 0.2 0.2 0.8"/>
      <geom type="box" pos="0  0.095 0.015" size="0.090 0.005 0.015" rgba="0.9 0.2 0.2 0.8"/>
      <geom type="box" pos="0 -0.095 0.015" size="0.090 0.005 0.015" rgba="0.9 0.2 0.2 0.8"/>
    </body>

    <!-- Khay chứa Pepsi (Bên trái bàn: Y = +0.32) -->
    <body name="pepsi_tray" pos="0.45 0.32 0.685">
      <geom name="pepsi_tray_base" type="box" size="0.10 0.10 0.005" material="pepsi_tray_mat"/>
      <!-- Thành khay -->
      <geom type="box" pos=" 0.095 0 0.015" size="0.005 0.10 0.015" rgba="0.2 0.4 0.9 0.8"/>
      <geom type="box" pos="-0.095 0 0.015" size="0.005 0.10 0.015" rgba="0.2 0.4 0.9 0.8"/>
      <geom type="box" pos="0  0.095 0.015" size="0.090 0.005 0.015" rgba="0.2 0.4 0.9 0.8"/>
      <geom type="box" pos="0 -0.095 0.015" size="0.090 0.005 0.015" rgba="0.2 0.4 0.9 0.8"/>
    </body>

  </worldbody>
</mujoco>
